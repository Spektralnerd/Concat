import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { ActionPair, Button, Modal } from "../primitives/modal.slint";
import { IconButton } from "../primitives/panel.slint";

export struct MissingMediaItem {
    id: string,
    name: string,
    /// Fork: the name in two parts, for a row too narrow for all of it.
    /// The end is never cut, since that is where names part company -
    /// "Scene-1183.mp4" and "Scene-1184.mp4" after the same film's title -
    /// and the start gives way; `tail` is empty for a name short enough
    /// to stand whole.
    head: string,
    tail: string,
    /// the folder it was in, the home folder as ~: the name is on the
    /// line above, so the whole path would only say it twice
    folder: string,
    /// 0 video, 1 audio, 2 image: which mark the row leads with
    kind: int,
    /// how many clips use it, on every timeline: what Remove takes too
    clips: int,
}

export struct RelinkData {
    open: bool,
    items: [MissingMediaItem],
}

// The files a project cannot find, one row each.
//
// A row says what the file is, where it was and how much of the edit
// hangs on it, and answers it one of two ways: Locate, a file picked by
// hand (a renamed file, or one on a phone, whose picker has no folders),
// or the bin, the file and its clips gone for good. The footer's Search
// answers every row at once from one folder; Not now leaves them
// offline, and the dialog quiet about them until they go missing anew.
export component RelinkDialog inherits Modal {
    in property <RelinkData> data;

    callback relink-all();
    /// Pick this one file by hand.
    callback locate(id: string);
    /// Take this file out of the project, with its clips, for good.
    callback remove(id: string);
    callback dismiss();

    open: root.data.open;
    title: I18n.t("relink.missingMedia");
    glyph: Glyph.link;
    surface-width: 560px;

    // The × and a click on the scrim are Not now, as Escape is.
    closed => { root.dismiss(); }

    /// One row's height; the list is as tall as its rows up to five of
    /// them, and scrolls past that.
    property <length> row-h: 52px;
    /// The list's height on a desk: its rows, up to five.
    property <length> card-h: Math.min(list.preferred-height, root.row-h * 5) + 2px;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        Text {
            text: I18n.t("relink.cantFind");
            color: Theme.fg-muted;
            font-size: Theme.fs;
            wrap: word-wrap;
            // Fork: never the part that grows. Filling a phone's screen,
            // this was the only thing that could, and it pushed the list
            // down under the buttons, five rows of fifty showing.
            vertical-stretch: 0;
            max-height: self.preferred-height;
        }

        // Fork: filling a phone's screen, the list takes the room the screen
        // has rather than five rows of it, and scrolls past that; on a desk
        // it is as tall as before.
        Rectangle {
            min-height: Math.min(root.card-h, root.row-h * 3 + 2px);
            preferred-height: root.card-h;
            max-height: root.fill ? list.preferred-height + 2px : root.card-h;
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: Theme.r;
            clip: true;

            flick := Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                // Fork: as wide as it is, so it moves only up and down and a
                // drag along a row is a scroll, not a sideways slip.
                content-width: self.width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: flick.width;
                    for item[index] in root.data.items: Rectangle {
                        height: root.row-h;

                        // A hairline between rows, none above the first.
                        if index > 0: Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 1px;
                            background: Theme.line;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: Theme.r-sm;
                                    background: Theme.field;

                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        glyph: item.kind == 1 ? Glyph.music
                                            : item.kind == 2 ? Glyph.image
                                            : Glyph.film;
                                        size: 15px;
                                        tint: Theme.fg-muted;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                // Fork: cut in the middle, not at the end.
                                // The start gives way first and the end -
                                // the part that tells a file from its
                                // neighbours - stays whole; a name that
                                // fits reads as one, with the room to
                                // spare after it.
                                HorizontalLayout {
                                    Text {
                                        text: item.head;
                                        color: Theme.fg;
                                        font-size: Theme.fs;
                                        font-weight: Theme.weight-title;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        max-width: self.preferred-width;
                                    }

                                    if item.tail != "": Text {
                                        text: item.tail;
                                        color: Theme.fg;
                                        font-size: Theme.fs;
                                        font-weight: Theme.weight-title;
                                        horizontal-stretch: 0;
                                        min-width: self.preferred-width;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: item.folder;
                                        color: Theme.fg-dim;
                                        font-size: Theme.fs-sm;
                                        font-family: Theme.font-technical;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if item.clips > 0: Text {
                                        text: item.clips == 1 ? I18n.t("relink.oneClip")
                                            : I18n.t1("relink.clips", "" + item.clips);
                                        color: Theme.fg-dim;
                                        font-size: Theme.fs-sm;
                                        horizontal-stretch: 0;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    label: I18n.t("relink.locate");
                                    clicked => { root.locate(item.id); }
                                }
                            }

                            // Gone for good, so it is never asked after
                            // again: the file and the clips made from it.
                            // Undo brings both back.
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: Glyph.trash;
                                    danger: true;
                                    label: I18n.t("relink.removeFromProject");
                                    clicked => { root.remove(item.id); }
                                }
                            }
                        }
                    }
                }
            }
        }

        ActionPair {
            max-height: self.preferred-height;
            cancel-label: I18n.t("relink.notNow");
            action-label: I18n.t("relink.searchFolder");
            action-glyph: Glyph.folder;
            cancel => { root.dismiss(); }
            act => { root.relink-all(); }
        }

        // Fork: what a phone's screen has left once the list shows every
        // row goes here, below the buttons, rather than into a gap above
        // the list. A card on a desk is as tall as what it holds and has
        // nothing left over.
        if root.fill: Rectangle {
            vertical-stretch: 0;
        }
    }
}
